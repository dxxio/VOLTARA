---
import Layout from "../layouts/Layout.astro";

const faqs = [
  {
    pregunta: "¿Cómo activo la garantía oficial de mi instrumento VOLTARA?",
    respuesta:
      "Puedes registrar el número de serie de tu instrumento escribiéndonos a través del formulario inferior. Todos los instrumentos VOLTARA cuentan con 2 años de cobertura oficial sobre mástiles, almas y componentes de audio.",
  },
  {
    pregunta: "¿Cuáles son las recomendaciones clave para el cuidado de mi guitarra o bajo?",
    respuesta:
      "Recomendamos mantener tu instrumento entre 40% y 55% de humedad relativa, limpiar el diapasón con aceites minerales neutros en cada cambio de cuerdas y evitar exponerlo a fuentes directas de calor o cambios bruscos de temperatura.",
  },
  {
    pregunta: "¿Dónde puedo descargar los manuales y diagramas de ajuste?",
    respuesta:
      "Contamos con guías de calibración de alma, especificaciones de radio de pastillas y alturas de cuerdas descargables solicitándolas con el modelo específico de tu instrumento.",
  },
  {
    pregunta: "¿Hacen envíos y cuentan con talleres autorizados?",
    respuesta:
      "Disponemos de red de asistencia y soporte directo de fábrica para calibración, reemplazo de potenciómetros y servicio técnico especializado.",
  },
];
---

<Layout titulo="Soporte Oficial VOLTARA | Garantía, FAQs y Contacto">
  <section class="seccion-soporte-page">
    <div class="contenedor">
      <header class="cabecera">
        <span class="pildora-tag">ATENCIÓN & ASISTENCIA TÉCNICA</span>
        <h1 class="h1-tit">Soporte VOLTARA</h1>
        <p class="bajada">
          Recursos autorizados para cuidado, registro de garantía, manuales y atención directa para
          músicos.
        </p>
      </header>

      <!-- 3 Pilares con Íconos SVG Puros (Sin emojis) -->
      <div class="grid-tres-pilares">
        <!-- Pilar 1: Garantía (SVG de Escudo) -->
        <div class="card-pilar">
          <div class="circulo-svg-icono">
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="M9 12l2 2 4-4"></path>
            </svg>
          </div>
          <h3>Garantía de Fábrica</h3>
          <p>
            2 años de cobertura completa en maderas, unión de mástil y componentes de audio para el
            comprador original.
          </p>
        </div>

        <!-- Pilar 2: Cuidado (SVG de Herramientas / Ajuste) -->
        <div class="card-pilar">
          <div class="circulo-svg-icono">
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
              ></path>
            </svg>
          </div>
          <h3>Cuidado del Instrumento</h3>
          <p>
            Guías prácticas de hidratación de diapasones, limpieza de trastes y almacenamiento
            seguro en funda o estuche.
          </p>
        </div>

        <!-- Pilar 3: Manuales (SVG de Documento Técnico) -->
        <div class="card-pilar">
          <div class="circulo-svg-icono">
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              <line x1="8" y1="6" x2="16" y2="6"></line>
              <line x1="8" y1="10" x2="16" y2="10"></line>
            </svg>
          </div>
          <h3>Manuales y Ajuste</h3>
          <p>
            Instrucciones oficiales para calibración de acción, quintaje, altura de pastillas y
            ajuste de alma.
          </p>
        </div>
      </div>

      <!-- Preguntas Frecuentes -->
      <div class="seccion-faqs">
        <h2 class="h2-sub">Preguntas Frecuentes</h2>
        <div class="faqs-lista">
          {
            faqs.map((f) => (
              <details class="faq-item">
                <summary class="faq-pregunta">
                  <span>{f.pregunta}</span>
                  <span class="faq-indicador">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="12" y1="5" x2="12" y2="19" />
                      <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                  </span>
                </summary>
                <p class="faq-respuesta">{f.respuesta}</p>
              </details>
            ))
          }
        </div>
      </div>

      <!-- Formulario de Contacto Funcional Visualmente -->
      <div class="seccion-formulario">
        <div class="caja-formulario">
          <span class="pildora-tag">MENSAJE DIRECTO</span>
          <h2 class="h2-form">Escribe al Equipo Técnico</h2>
          <p class="p-form">
            ¿Tienes consultas sobre un modelo, calibración o número de serie? Envíanos tu mensaje.
          </p>

          <form id="form-soporte" class="form-grid">
            <div class="campo">
              <label for="nombre">Nombre y Apellidos</label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                required
                placeholder="Ej: Carlos Santana"
              />
            </div>

            <div class="campo">
              <label for="email">Correo Electrónico</label>
              <input type="email" id="email" name="email" required placeholder="tu@correo.com" />
            </div>

            <div class="campo">
              <label for="modelo">Modelo de Instrumento</label>
              <select id="modelo" name="modelo">
                <option value="V100">VOLTARA V100 (Eléctrica)</option>
                <option value="V200">VOLTARA V200 (Eléctrica)</option>
                <option value="A200">VOLTARA A200 (Acústica)</option>
                <option value="B300">VOLTARA B300 (Bajo)</option>
                <option value="otro">Otra consulta general</option>
              </select>
            </div>

            <div class="campo campo-completo">
              <label for="mensaje">Consulta o Número de Serie</label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="4"
                required
                placeholder="Cuéntanos en qué podemos ayudarte..."></textarea>
            </div>

            <div class="campo-completo">
              <button type="submit" class="btn-enviar-form">
                <span>ENVIAR MENSAJE A SOPORTE</span>
                <span class="flecha">&rarr;</span>
              </button>
            </div>
          </form>

          <div id="mensaje-exito" class="alerta-exito" style="display: none;">
            <p>
              ✓ ¡Mensaje recibido con éxito! Nuestro equipo de luthería y asistencia técnica se
              pondrá en contacto contigo a la brevedad.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .seccion-soporte-page {
    padding: 5rem 0 6rem 0;
    background-color: var(--c-fondo);
  }
  .contenedor {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .cabecera {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3.5rem auto;
  }
  .pildora-tag {
    display: inline-block;
    padding: 0.4rem 1.1rem;
    border-radius: var(--radio-pildora);
    background-color: var(--c-superficie);
    border: 1px solid var(--c-rojo);
    color: var(--c-rojo);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
  }
  .h1-tit {
    font-size: clamp(2.8rem, 5vw, 4.4rem);
    color: var(--c-crema);
    margin-bottom: 0.75rem;
  }
  .bajada {
    font-size: 1.05rem;
    color: var(--c-texto-suave);
    line-height: 1.6;
  }

  /* Pilares con SVG */
  .grid-tres-pilares {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 5rem;
  }
  .card-pilar {
    background-color: var(--c-superficie);
    border: 1px solid var(--c-borde);
    border-radius: var(--radio-curvo);
    padding: 2.25rem 1.75rem;
    text-align: center;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease;
  }
  .card-pilar:hover {
    transform: translateY(-4px);
    border-color: var(--c-rojo);
  }
  .circulo-svg-icono {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: var(--c-tarjeta);
    border: 1px solid var(--c-borde);
    color: var(--c-rojo);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem auto;
    box-shadow: 0 4px 15px rgba(230, 25, 25, 0.2);
  }
  .card-pilar h3 {
    font-size: 1.6rem;
    color: var(--c-crema);
    margin-bottom: 0.5rem;
  }
  .card-pilar p {
    font-size: 0.88rem;
    color: var(--c-texto-suave);
    line-height: 1.6;
  }

  /* FAQs */
  .seccion-faqs {
    margin-bottom: 5rem;
  }
  .h2-sub {
    font-size: 2.4rem;
    color: var(--c-crema);
    text-align: center;
    margin-bottom: 2rem;
  }
  .faqs-lista {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 850px;
    margin: 0 auto;
  }
  .faq-item {
    background-color: var(--c-superficie);
    border: 1px solid var(--c-borde);
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }
  .faq-item[open] {
    border-color: var(--c-rojo);
  }
  .faq-pregunta {
    font-size: 1rem;
    font-weight: 700;
    color: var(--c-crema);
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }
  .faq-indicador {
    color: var(--c-rojo);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }
  .faq-item[open] .faq-indicador {
    transform: rotate(45deg);
  }
  .faq-respuesta {
    font-size: 0.9rem;
    color: var(--c-texto-suave);
    line-height: 1.6;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--c-borde);
  }

  /* Formulario */
  .caja-formulario {
    background-color: var(--c-superficie);
    border: 1px solid var(--c-borde-fuerte);
    border-radius: var(--radio-curvo);
    padding: 3.5rem 2.5rem;
    max-width: 850px;
    margin: 0 auto;
    text-align: center;
  }
  .h2-form {
    font-size: 2.4rem;
    color: var(--c-crema);
    margin: 0.5rem 0;
  }
  .p-form {
    font-size: 0.95rem;
    color: var(--c-texto-suave);
    margin-bottom: 2.5rem;
  }
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    text-align: left;
  }
  .campo {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .campo-completo {
    grid-column: 1 / -1;
  }
  label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--c-crema);
    letter-spacing: 0.05em;
  }
  input,
  select,
  textarea {
    background-color: var(--c-fondo);
    border: 1px solid var(--c-borde);
    border-radius: 10px;
    padding: 0.85rem 1rem;
    color: var(--c-crema);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s ease;
  }
  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--c-rojo);
  }
  .btn-enviar-form {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    padding: 1.1rem;
    border-radius: var(--radio-pildora);
    background: linear-gradient(135deg, var(--c-rojo) 0%, var(--c-rojo-oscuro) 100%);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    box-shadow: 0 6px 20px rgba(230, 25, 25, 0.4);
    transition: all 0.25s ease;
  }
  .btn-enviar-form:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(230, 25, 25, 0.6);
  }
  .alerta-exito {
    margin-top: 1.5rem;
    background-color: rgba(217, 130, 43, 0.15);
    border: 1px solid var(--c-ambar);
    color: var(--c-crema);
    padding: 1rem;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  @media (max-width: 800px) {
    .grid-tres-pilares {
      grid-template-columns: 1fr;
    }
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById("form-soporte");
  const alerta = document.getElementById("mensaje-exito");

  if (form && alerta) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      alerta.style.display = "block";
      (form as HTMLFormElement).reset();
    });
  }
</script>
