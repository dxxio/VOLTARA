---
/*
  Contenedor: centra el contenido y le da el ancho máximo del sitio.
  El ancho máximo sale de la sección 5 del brief: se cambia SOLO aquí.

  Uso:
    <Contenedor>...contenido...</Contenedor>
*/

interface Props {
  class?: string;
}

const { class: clase } = Astro.props;
---

<div class:list={["max-w-5xl px-4 sm:px-6 mx-auto w-full", clase]}>
  <slot />
</div>
