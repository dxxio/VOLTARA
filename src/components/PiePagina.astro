---
import { sitio } from "../datos/sitio";

const anoActual = 2026;
---

<footer class="mt-auto w-full border-t border-[#3D352E] bg-[#141210]">
  <div class="max-w-7xl px-4 sm:px-8 py-12 md:py-16 mx-auto">
    <div class="md:grid-cols-4 gap-8 md:gap-12 mb-12 grid grid-cols-1">
      <!-- Columna 1: Logotipo Oficial Fender al 80% de opacidad y Eslogan -->
      <div class="space-y-4 md:col-span-2">
        <a href="/" class="py-1 inline-block" aria-label="Fender - Inicio">
          <img
            src={sitio.logo.archivo}
            alt={sitio.logo.alt}
            class="h-8 w-auto object-contain opacity-80 transition-opacity duration-300 hover:opacity-100"
            height="32"
          />
        </a>
        <p class="text-sm max-w-sm leading-relaxed text-[#CA8EB2]">
          {sitio.eslogan}
          {sitio.descripcion}
        </p>
      </div>

      <!-- Columna 2: Navegación Rápida -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold tracking-wider text-[#F5F2E8] uppercase">Explorar</h4>
        <ul class="space-y-2 text-sm">
          {
            sitio.menu.map((item) => (
              <li>
                <a
                  href={item.ruta}
                  class="text-[#CA8EB2] transition-colors duration-300 hover:text-[#D9381E]"
                >
                  {item.texto}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna 3: Contacto y Redes Sociales -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold tracking-wider text-[#F5F2E8] uppercase">Conexión Oficial</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href={`mailto:${sitio.correo}`}
              class="break-all text-[#CA8EB2] transition-colors duration-300 hover:text-[#D9381E]"
            >
              {sitio.correo}
            </a>
          </li>
          {
            sitio.redes.map((red) => (
              <li>
                <a
                  href={red.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="gap-1.5 inline-flex items-center text-[#CA8EB2] transition-colors duration-300 hover:text-[#D9381E]"
                >
                  <span>{red.nombre}</span>
                  <span class="text-xs" aria-hidden="true">
                    &nearr;
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Barra Inferior de Derechos y Copyright -->
    <div
      class="pt-8 sm:flex-row gap-4 text-xs flex flex-col items-center justify-between border-t border-[#3D352E]/60 text-[#CA8EB2]"
    >
      <p class="sm:text-left text-center">
        {sitio.pie}
      </p>
      <p class="sm:text-right text-center">
        Diseñado bajo especificaciones de interfaz oficial Fender &bull; WCAG AA
      </p>
    </div>
  </div>
</footer>
